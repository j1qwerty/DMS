# =============================================================================
# RecordRoom API — deployment configuration
# =============================================================================
# Copy this file to `.env` next to the API (or set DOTNET_ENV_FILE to a path)
# and edit the values. Every key can also be a plain environment variable —
# the .env file is read first, so an env var or command line always wins.
#
# Hierarchy separator is the double underscore: `Section__Key`.
# Booleans accept true/false, 1/0, on/off, yes/no, enabled/disabled.
# The appsettings.json defaults apply for anything left commented out.
# =============================================================================

# ---------------------------------------------------------------- connections
# SQL Server. Required.
ConnectionStrings__Default="Server=localhost;Database=RecordRoom;Trusted_Connection=True;TrustServerCertificate=True"

# ----------------------------------------------------------------------- auth
# JWT signing. SigningKey must be at least 32 characters; change it in production.
Jwt__Issuer=record-room-api
Jwt__Audience=record-room-frontend
Jwt__SigningKey=dev-only-signing-key-change-me-in-production-000000
Jwt__ExpiryMinutes=120

# -------------------------------------------------------------------- storage
# Where uploaded scans, maps and built deliverable PDFs are stored on disk.
# Relative paths resolve against the API folder; absolute paths are used as-is.
# The database stores only generated keys, so moving the library is: stop the
# API, move the folder, change this value, start the API.
FileStorage__RootPath=App_Data/documents
# Hard upload ceiling in bytes (48 MiB default, clamped — keep nginx
# client_max_body_size above it).
FileStorage__MaxUploadBytes=50331648

# ------------------------------------------------------------- demo behaviour
# true  = a fresh, empty database is seeded with the demo registry (employees,
#         rooms, files, receipts, demo accounts) — the explorable demo site.
#         The UI shows a "demo data" badge while this is on.
# false = production. A fresh database gets bootstrap rows only: the permission
#         matrix, feature-switch defaults and the standard accounts
#         (admin / supervisor / operator / employee, password Demo@12345 —
#         change them after first login). No demo files are created.
App__DemoMode=true

# Database bootstrap switches. MigrateOnStartup applies EF migrations on boot;
# SeedOnStartup turns the seeding above on or off entirely.
Database__MigrateOnStartup=true
Database__SeedOnStartup=true

# --------------------------------------------------------- settings lockdown
# false = the feature switchboard (Settings → Feature visibility, the
#         PUT /api/config/features endpoint) is locked to this environment.
#         The API answers 403 to toggle attempts and Settings shows the
#         switches read-only. Production deployments that manage configuration
#         only through this file set it to false.
# true  = an Admin may toggle the feature groups at runtime (audited).
Settings__AllowFeatureEditing=true

# ------------------------------------------------------------ feature groups
# Defaults for the optional feature groups, applied when no FeatureSettings row
# exists yet (an Admin's stored choice — or the lock above — takes precedence).
# Groups: barcode (barcode centre + scan validation), recordRoom (rooms &
# shelves), maps (scanned maps & file copies), support (help & support page).
Features__BarcodeEnabled=true
Features__RecordRoomEnabled=false
Features__MapsEnabled=false
Features__SupportEnabled=false

# ------------------------------------------------------------------------ OCR
# Hindi + English recognition through the tesseract CLI.
# TesseractPath: "tesseract" needs it on PATH; otherwise an absolute path.
#   Ubuntu:  apt-get install -y tesseract-ocr tesseract-ocr-hin tesseract-ocr-eng
#   Windows: install the UB Mannheim build and point TesseractPath at it.
# TessDataPath: folder with the .traineddata models. The repo ships
#   tessdata/ (hin + eng) and it is copied into the publish output; set an
#   absolute path to use models installed elsewhere.
# Languages: tesseract -l argument; "hin+eng" needs hin.traineddata and
#   eng.traineddata in the tessdata folder.
# MaxPdfPages: how many PDF pages one OCR pass rasterizes (each page is a
#   tesseract run — lower it on weak hardware, raise it for long documents).
# The OCR screen shows the live engine status from GET /api/config.
Ocr__Enabled=true
Ocr__TesseractPath=tesseract
Ocr__TessDataPath=tessdata
Ocr__Languages=hin+eng
Ocr__TimeoutSeconds=120
Ocr__MaxPdfPages=10

# -------------------------------------------------------------- scan quality
# Minimum horizontal DPI for uploaded scan images; 0 disables the gate.
Quality__MinimumScanDpi=200

# -------------------------------------------------------------------- search
# true = force the LIKE search path even when SQL Server full-text is installed.
Search__UseFullText=false

# ----------------------------------------------------------------- frontend
# Allowed CORS origins for the web app (comma-free JSON array spelling works in
# env files too — one value per line here is not supported; set it as one string
# in appsettings or via environment with JSON brackets if you need several).
Cors__AllowedOrigins__0=http://localhost:5173

# ------------------------------------------------------- cache / background
# Empty = in-memory cache and node-local SignalR; set a Redis connection string
# to share cache + realtime across API nodes.
Redis__ConnectionString=
# InMemory or SqlServer (persists background jobs in the same database).
Hangfire__Storage=InMemory
Hangfire__EnableScheduling=true
Hangfire__OverdueSweepCron=*/15 * * * *
Hangfire__AuditRetentionCron=30 2 * * *

# ------------------------------------------------------------------- swagger
# Keep Swagger off in production when the API is internet-reachable.
Swagger__Enabled=true

# ---------------------------------------------------------- rate limiting
# Fixed-window limits on sensitive endpoints (see RateLimitMiddleware).
# RateLimiting__PermitLimit=20
# RateLimiting__WindowSeconds=60

# ------------------------------------------------------------------ notes
# The systemd deployment (deploy-recordroom.ps1) writes /etc/recordroom/recordroom.env
# and loads it through EnvironmentFile= — the same keys, no .env file needed.
# A .env file in the API folder is read on top of that, and real environment
# variables override both.
