{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.EntityFrameworkCore.Database.Command":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "Features":  {
                     "BarcodeEnabled":  true
                 },
    "ConnectionStrings":  {
                              "Default":  "Server=localhost;Database=RecordRoom;Trusted_Connection=True;TrustServerCertificate=True"
                          },
    "Jwt":  {
                "Issuer":  "record-room-api",
                "Audience":  "record-room-frontend",
                "SigningKey":  "dev-only-signing-key-change-me-in-production-000000",
                "ExpiryMinutes":  120
            },
    "Database":  {
                     "MigrateOnStartup":  true,
                     "SeedOnStartup":  true
                 },
    // Where uploaded scans, maps and studio-built PDFs are stored on disk.
    // The database stores only generated storage keys (never paths), so the
    // whole library can be moved by changing RootPath and copying the folder.
    //   RootPath       default: App_Data/documents inside the API folder.
    //                  A relative path is resolved against the API folder;
    //                  an absolute path (D:\RecordRoom\documents or
    //                  /var/lib/recordroom/documents) is used as-is.
    //                  Environment variable override: FileStorage__RootPath
    //                  (the value logged as "Document storage root" at startup).
    //   MaxUploadBytes default: 50331648 (48 MiB, hard ceiling; the value is
    //                  clamped to it). Override: FileStorage__MaxUploadBytes.
    "FileStorage":  {
                        "RootPath":  "App_Data/documents",
                        "MaxUploadBytes":  50331648
                    },
    "Redis":  {
                  "ConnectionString":  ""
              },
    "Hangfire":  {
                     "Storage":  "InMemory",
                     "EnableScheduling":  true,
                     "OverdueSweepCron":  "*/15 * * * *",
                     "AuditRetentionCron":  "30 2 * * *"
                 },
    "Swagger":  {
                    "Enabled":  true
                },
    "Ocr":  {
                "Enabled":  true,
                "TesseractPath":  "tesseract",
                "TessDataPath":  "tessdata",
                "Languages":  "hin+eng",
                "TimeoutSeconds":  120
            },
    "Cors":  {
                 "AllowedOrigins":  [
                                        "http://localhost:5173"
                                    ]
             }
}
