<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Pinned above the 2.5.302 that SignalR.StackExchangeRedis pulls in
         transitively; 2.5.302 is GHSA-qhrr-8q5h-9q3h (moderate). -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <!-- Pinned above the 9.0.11 that comes in transitively; 9.0.11 carries
         GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261012" />
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-x64" Version="5.0.0.20261012" />
    <!-- The natives are runtime-specific: only linux-x64 shipped, so on a Windows
         dev box PDFium rasterization threw DllNotFoundException (OpenCvSharpExtern)
         and every PDF silently OCR'd to nothing. Matching version on purpose —
         the managed binding and the native binary are built together. -->
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261012"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!-- The tesseract language models ship with the repository and must follow
       the app into every publish output, or OCR quietly finds no hin+eng data
       (TesseractOcrEngine looks them up next to the DLL first). -->
  <ItemGroup>
    <Content Include="..\..\tessdata\**\*.traineddata" CopyToOutputDirectory="PreserveNewest" LinkBase="tessdata" />
    <None Update="ocr-worker\paddle_worker.py;ocr-worker\requirements.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
